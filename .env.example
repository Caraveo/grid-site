# Required in production for POST /api/mesh/ping
# On Cloudflare: npx wrangler secret put GRID_WEBHOOK_SECRET
GRID_WEBHOOK_SECRET=change-me-to-a-long-random-string

# Admin dashboard (/admin) — min 16 chars
# On Cloudflare: npx wrangler secret put GRID_ADMIN_SECRET
GRID_ADMIN_SECRET=change-me-admin-secret-16chars+

# Public name registration fee (USD, Cash App only → $Caraveo)
REGISTRATION_FEE_USD=5

# Public phase label on the mesh
GRID_PHASE=1

# Genesis globe pin (quantized anyway)
GENESIS_LAT=37.5
GENESIS_LNG=-122.0
GENESIS_LABEL=GENESIS
GENESIS_REGION=Origin

# Production site
# GRID_SITE_URL=https://grid-compute.com
