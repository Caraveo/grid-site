{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "grid-site",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-28",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "run_worker_first": ["/.well-known/*"],
  },
  "observability": {
    "enabled": true,
  },
  // Custom domain — zone must already be on this Cloudflare account.
  // If deploy fails on routes, attach the domain in the dashboard or
  // temporarily remove this block and re-add after DNS is ready.
  "routes": [
    { "pattern": "grid-compute.com", "custom_domain": true },
    { "pattern": "www.grid-compute.com", "custom_domain": true },
    { "pattern": "docs.grid-compute.com", "custom_domain": true },
    { "pattern": "explorer.grid-compute.com", "custom_domain": true },
    { "pattern": "engine.grid-compute.com", "custom_domain": true },
    { "pattern": "mail.grid-compute.com", "custom_domain": true },
    { "pattern": "ark.grid-compute.com", "custom_domain": true },
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "grid-site",
    },
    {
      "binding": "MESH_AUTH",
      "service": "grid-mesh-auth",
    },
  ],
  // Durable mesh peer store (location-only globe pings).
  "kv_namespaces": [
    {
      "binding": "MESH_KV",
      "id": "5208b9e52eb14933bdee027cb124c3f7",
    },
  ],
  // Durable contributor identity, sessions, approvals and audit records.
  "d1_databases": [
    {
      "binding": "CONTRIBUTOR_DB",
      "database_name": "grid-contributors",
      "database_id": "b190a6fc-8774-464b-b38e-3b6a30d9cc0b",
      "migrations_dir": "migrations",
    },
  ],
  // Non-secret defaults (override in dashboard).
  "vars": {
    "GRID_PHASE": "1",
    "GENESIS_LAT": "39.0",
    "GENESIS_LNG": "-77.5",
    "GENESIS_LABEL": "GENESIS",
    "GENESIS_REGION": "US-EAST-1",
    "GENESIS_API_URL": "https://genesis.grid-compute.com",
    "MAIL_DOMAIN": "gridmail.dev",
    "MAIL_SYSTEM_SENDER": "hi@gridmail.dev",
    "CONTRIBUTOR_APP_ORIGIN": "https://grid-compute.com",
    "CONTRIBUTOR_BOOTSTRAP_ADMIN_EMAIL": "hi@grid-compute.com",
  },
  // Secrets (never commit):
  //   npx wrangler secret put GRID_ADMIN_SECRET   # min 16 chars, admin dashboard
  //   npx wrangler secret put AWS_MAIL_API_URL
  //   npx wrangler secret put AWS_MAIL_API_SECRET
  //   npx wrangler secret put CONTRIBUTOR_ENCRYPTION_KEY
  //   npx wrangler secret put CONTRIBUTOR_IP_PEPPER
}
